# Copy this file to .env and fill in your keys. Never commit the real .env file.

# Primary LLM provider (free tier) - https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Fallback LLM provider (free tier) - https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Web research provider - https://app.tavily.com
TAVILY_API_KEY=

# Optional: override SQLite file location
DB_PATH=data/smedia.db
